/*
 * Corne keymap: coding and Claude Code on macOS, built to minimise holding.
 *
 * Design rules:
 *   1. All four modifiers are STICKY (&sk) and all four are on the base layer
 *      in prime positions. Tap and release, then press the next key.
 *      Sticky keys still act as normal held modifiers if you DO hold them, so
 *      Cmd-click, Opt-click and Shift-click all still work.
 *   2. Home-row modifiers, but the hold LATCHES a sticky mod rather than
 *      staying held through the chord, so a press is ~180ms rather than the
 *      length of the shortcut. This replaces an earlier no-hold-tap rule:
 *      reaching the outer column turned out to cost more than a 180ms hold.
 *   3. ESC is top-left. ' keeps its normal home-row spot; TAB takes the
 *      leftover right pinky bottom slot, since ESC already owns top-left.
 *   4. Every modifier is under the LEFT hand, on the home row or the thumb,
 *      so they chord with right-hand letters and with the mouse without
 *      the hand ever leaving home position.
 *   5. The shell and Claude Code chords you press constantly are bound as
 *      SINGLE keys on NAV, so heavy Ctrl use does not mean heavy Ctrl holding.
 *   6. Five layers, no combos. Combos on the thumbs all collided with real
 *      bigrams (SPACE-RET, Cmd-Shift), so every layer is reached by a key.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define SYS  4


/ {
        behaviors {
                /* Home-row modifier. HOLD latches a sticky modifier, TAP types the
                 * letter. Because the hold LATCHES, you release the home-row key
                 * before pressing the next one, so nothing is held through the chord
                 * and same-hand shortcuts like Cmd-C work normally. That is why no
                 * hold-trigger-key-positions restriction is used here: it would break
                 * Cmd-C, Cmd-V and Cmd-X, all of which are left-hand letters.
                 *
                 * require-prior-idle-ms is the setting that stops misfires while
                 * typing fast: if you pressed another key within 150ms, this resolves
                 * as a tap immediately and never as a modifier.
                 */
                hm: homerow_sticky_mod {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <180>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        bindings = <&sk>, <&kp>;
                };
        };
};

/ {
        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        display-name = "Base";
// ------------------------------------------------------------------------------------------
// | ESC  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BKSP |
// |CAPSW |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | TAB  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | DEL  |
//                    |*CMD | NAV | SPC |   | ENT | SYM |*SHFT|
// HOME-ROW MODIFIERS, so no modifier sits in the outer column any more:
//     hold A = Shift    hold S = Opt    hold D = Ctrl    hold F = Cmd
//     tap   A = a       tap   S = s     etc.
// The hold LATCHES a sticky modifier after ~180ms, so you release the home-row
// key and then press the next one. Nothing is held through the chord itself.
// *CMD on the left thumb and *SHFT on the right thumb remain as direct routes
// for the two most-used modifiers, and both still hold normally for
// Cmd-click and Shift-click.
                        bindings = <
   &kp ESC     &kp Q       &kp W      &kp E      &kp R       &kp T      &kp Y   &kp U   &kp I     &kp O   &kp P    &kp BSPC
   &caps_word  &hm LSHFT A &hm LALT S &hm LCTRL D &hm LGUI F &kp G      &kp H   &kp J   &kp K     &kp L   &kp SEMI &kp SQT
   &kp TAB     &kp Z       &kp X      &kp C      &kp V       &kp B      &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH &kp DEL
                    &sk LGUI &sl NAV &kp SPACE   &kp RET &sl SYM &sk LSHFT
                        >;
                };

                nav_layer {
                        display-name = "Nav";
// ------------------------------------------------------------------------------------------
// |CAPSW |^+TAB| ^RET| ^-R | ^-L | PTT |   | HOME| PGDN| PGUP| END | DEL |^BKSP |
// |      | ^-A | ^-E | ^-W | ^-U | ^-K |   | LEFT| DOWN|  UP | RGHT| BACK| FWD  |
// |      | ^-C | ^-D |SHOT4|HFREE|CMDTB|   | W<- | LN<-| LN->| W-> | UNDO| REDO |
//                    |     |     |SPOTL|   | ENT | SYS |*SHFT|
// LEFT HAND = shell + Claude Code, every one a SINGLE press, no modifier held:
//   ^-A start of line   ^-E end of line   ^-W delete word   ^-U delete line
//   ^-K kill to end     ^-C interrupt     ^-D EOF           ^-L clear
//   ^-R reverse search
// Wispr Flow dictation. Flow's default fn and fn+space CANNOT be used: ZMK
// cannot send Apple's fn. Flow also REQUIRES at least one modifier in a
// shortcut, so a bare F-key is rejected as an invalid key. Modifier+F13/F14
// is the safest pairing available: F13-F19 have no default macOS binding at
// all, and the added modifier satisfies Flow's validator.
// Set in Flow Hub > Settings > General > Shortcuts > Change:
//     push-to-talk -> Opt+F13    hands-free -> Opt+F14
//   PTT   = &kp LA(F13) on the T key. Hold to talk, release to stop and paste.
//           Use for short phrases.
//   HFREE = &kp LA(F14) on the bottom-row index key. Tap to start dictating,
//           tap again to stop. Nothing is held. Use this by default.
// No &kt latch here: latching a modifier combo would leave Ctrl/Opt stuck
// down and turn every later keystroke into a chord.
// SYS also carries PASTE = Cmd+Ctrl+V, Flow's paste-last-transcript.
//   ^+TAB = Shift-Tab, Claude Code mode cycle
//   ^RET  = Option-Return, newline inside a prompt without submitting
// RIGHT HAND = motion. W<- / W-> are Option-Arrow word jumps, LN<- / LN->
// are Cmd-Arrow line jumps, BACK / FWD are Cmd-[ and Cmd-].
                        bindings = <
   &trans     &kp LS(TAB) &kp LA(RET) &kp LC(R)      &kp LC(L)      &kp LA(F13)   &kp HOME     &kp PG_DN    &kp PG_UP     &kp END       &kp DEL      &kp LA(BSPC)
   &trans &kp LC(A)   &kp LC(E)   &kp LC(W)      &kp LC(U)      &kp LC(K)     &kp LEFT     &kp DOWN     &kp UP        &kp RIGHT     &kp LG(LBKT) &kp LG(RBKT)
   &trans &kp LC(C)   &kp LC(D)   &kp LG(LS(N4)) &kp LA(F14)    &kp LG(TAB)   &kp LA(LEFT) &kp LG(LEFT) &kp LG(RIGHT) &kp LA(RIGHT) &kp LG(Z)    &kp LG(LS(Z))
                      &trans      &trans         &kp LG(SPACE)                &kp RET      &mo SYS      &sk LSHFT
                        >;
                };

                sym_layer {
                        display-name = "Sym";
// ------------------------------------------------------------------------------------------
// | NUM  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// |      |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  _   |
// |      |  `  |  ~  |  \  | "|" |  -  |   |  =  |  [  |  ]  |  {  |  }  |  :   |
//                    |     | SYS | SPC |   |  .  |     |*SHFT|
// Digits keep their normal left-to-right order, and the shifted symbol for each
// digit sits directly below it, so there is nothing new to memorise.
// Not on this layer, because they are one Shift away from a key you already have:
//   "  = Shift '     +  = Shift =     ?  = Shift /     <  >  = Shift , .
                        bindings = <
   &tog NUM &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7   &kp N8    &kp N9   &kp N0   &kp BSPC
   &trans &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp UNDER
   &trans &kp GRAVE &kp TILDE &kp BSLH  &kp PIPE  &kp MINUS    &kp EQUAL &kp LBKT &kp RBKT  &kp LBRC &kp RBRC &kp COLON
                    &trans    &mo SYS   &kp SPACE               &kp DOT   &trans   &sk LSHFT
                        >;
                };

                num_layer {
                        display-name = "Num";
// ------------------------------------------------------------------------------------------
// | NUM  |     |     |     |     |     |   |  =  |  7  |  8  |  9  |  /  | BKSP |
// |      |     |     |     |     |     |   |  -  |  4  |  5  |  6  |  *  | ENT  |
// |      |     |     |     |     |     |   |  +  |  1  |  2  |  3  |  ,  |  .   |
//                    |     |     |     |   |  0  |     |     |
// Toggled from SYM's top-left key, and off again from the same physical key,
// so it stays on while you key in a long number without holding anything.
// The whole left half falls through to Base, so letters and all four sticky
// modifiers still work while the numpad is active.
                        bindings = <
   &tog NUM &trans &trans &trans &trans &trans  &kp EQUAL &kp N7 &kp N8 &kp N9 &kp FSLH  &kp BSPC
   &trans &trans &trans &trans &trans &trans    &kp MINUS &kp N4 &kp N5 &kp N6 &kp ASTRK &kp RET
   &trans &trans &trans &trans &trans &trans    &kp PLUS  &kp N1 &kp N2 &kp N3 &kp COMMA &kp DOT
                 &trans &trans &trans           &kp N0    &trans &trans
                        >;
                };

                sys_layer {
                        display-name = "Sys";
// ------------------------------------------------------------------------------------------
// |STUDIO| BT0 | BT1 | BT2 | BT3 |BTCLR|   |  F1 |  F2 |  F3 |  F4 |  F5 |  F6  |
// | BOOT | USB | BLE |GLOBE|PASTE|     |   |  F7 |  F8 |  F9 | F10 | F11 | F12  |
// | RESET|     |     |     |     |     |   | MUTE| VOL-| VOL+| PREV| NEXT|RESET |
//                    |     |     |     |   |     |     |     |
// Reached with &mo SYS from NAV or SYM.
// GLOBE is ZMK's nearest equivalent to the Mac fn/Globe key. It sends HID
// consumer usage 0x029D, which macOS accepts for input-source switching and
// the emoji picker. It is NOT a true Apple fn: it is not treated as a
// modifier, so Globe+arrow and fn+F-key chords do not work. Everything fn
// is normally used for is already bound directly: DEL and HOME/END/PGUP/PGDN
// on NAV, F1-F12 on this layer.
                        bindings = <
   &studio_unlock &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR   &kp F1     &kp F2       &kp F3       &kp F4     &kp F5     &kp F6
   &bootloader    &out OUT_USB &out OUT_BLE &kp GLOBE    &kp LC(LG(V)) &none        &kp F7     &kp F8       &kp F9       &kp F10    &kp F11    &kp F12
   &sys_reset     &none        &none        &none        &none        &none        &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_NEXT &sys_reset
                                            &trans       &trans       &trans                   &trans       &trans       &trans
                        >;
                };
        };
};

/* Sticky behaviour tuning.
 * release-after-ms 2000: two seconds to press the next key instead of the
 * default one second, so you are never rushing a chord.
 * ignore-modifiers: lets you stack sticky mods, so Cmd then Shift then key
 * works, and so Shift can be added on top of an active SYM layer.
 */
&sk {
        release-after-ms = <2000>;
        ignore-modifiers;
};

&sl {
        release-after-ms = <2000>;
};

/* caps_word survives _ and - so SNAKE_CASE, CONSTANT_NAMES and SQL keywords
 * all complete in one shot.
 */
&caps_word {
        continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};
