/*
 * Corne keymap: coding and Claude Code on macOS, built to minimise holding.
 *
 * Design rules:
 *   1. All four modifiers are STICKY (&sk) and all four are on the base layer
 *      in prime positions. Tap and release, then press the next key.
 *      Sticky keys still act as normal held modifiers if you DO hold them, so
 *      Cmd-click, Opt-click and Shift-click all still work.
 *   2. No hold-tap on letter keys and no home-row mods. Every base-layer key
 *      does exactly one thing, so there is no hold timing to learn and no
 *      misfire to diagnose. Holding is also the thing that hurts.
 *   3. ESC is top-left. ' keeps its normal home-row spot. Shift takes the
 *      right pinky bottom slot, where every standard keyboard puts it, and
 *      TAB goes to the right outer thumb: TAB is pressed more than Shift on
 *      this keymap, because SYM binds the shifted symbols directly, so Shift
 *      is only capitals and shortcuts. The more frequent key gets the
 *      stronger digit, and the right pinky sheds load.
 *   4. Ctrl and Opt own the left outer column, Cmd and Shift the thumbs, so
 *      every modifier is under the LEFT hand and chords with right-hand
 *      letters and with the mouse.
 *   5. The shell and Claude Code chords you press constantly are bound as
 *      SINGLE keys on NAV, so heavy Ctrl use does not mean heavy Ctrl holding.
 *   6. Five layers, no combos. Combos on the thumbs all collided with real
 *      bigrams (SPACE-RET, Cmd-Shift), so every layer is reached by a key.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define SYS  4


/ {
        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        display-name = "Base";
// ------------------------------------------------------------------------------------------
// | ESC  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BKSP |
// |*CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | *OPT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |*SHFT |
//                    |*CMD | NAV | SPC |   | ENT | SYM | TAB  |
// Every letter key is a plain keypress. Nothing on this layer is a hold-tap,
// so there is no tapping term to fight and no way to misfire a modifier.
// All four *modifiers are sticky: tap one, then press the next key. They also
// still work as ordinary held modifiers, so Cmd-click, Opt-click and
// Shift-click are unchanged.
//     Ctrl sits where a Mac's Caps Lock is, which is where most terminal
//     users remap it already. Opt is directly below it. Cmd is the left outer
//     thumb, Shift the right outer thumb.
// Because the modifiers are separate keys rather than layered onto letters,
// same-key shortcuts are just two taps: Opt+S is tap OPT, tap S.
// Push-to-talk moved to NAV's outer thumb so TAB could keep a plain base key,
// and backtick lives on SYM (SYM then Z) rather than taking a modifier's slot.
                        bindings = <
   &kp ESC    &kp Q &kp W &kp E &kp R &kp T      &kp Y   &kp U   &kp I     &kp O   &kp P    &kp BSPC
   &sk LCTRL  &kp A &kp S &kp D &kp F &kp G      &kp H   &kp J   &kp K     &kp L   &kp SEMI &kp SQT
   &sk LALT   &kp Z &kp X &kp C &kp V &kp B      &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH &sk LSHFT
                    &sk LGUI &sl NAV &kp SPACE   &kp RET &sl SYM &kp TAB
                        >;
                };

                nav_layer {
                        display-name = "Nav";
// ------------------------------------------------------------------------------------------
// |CAPSW |^+TAB| ^RET| ^-R | ^-L |HFREE|   | HOME| PGDN| PGUP| END | DEL |^BKSP |
// |      | ^-A | ^-E | ^-W | ^-U | ^-K |   | LEFT| DOWN|  UP | RGHT| BACK| FWD  |
// |      | ^-C | ^-D |SHOT4|SHOT5|CMDTB|   | W<- | LN<-| LN->| W-> | UNDO| REDO |
//                    | PTT |     |SPOTL|   | ENT | SYS | TAB  |
// PTT sits on the left OUTER THUMB. Tap the middle thumb for NAV, then slide
// the same thumb out one key and hold. The thumb is the strongest digit on the
// board, which matters here because this is the longest hold in the keymap: it
// lasts as long as the sentence being dictated. Any finger position would be
// worse, and the two keys are adjacent so it is one motion.
// The outer column stays &trans on both lower rows, so it falls through to
// Ctrl and Opt and keeps both reachable without leaving this layer.
// LEFT HAND = shell + Claude Code, every one a SINGLE press, no modifier held:
//   ^-A start of line   ^-E end of line   ^-W delete word   ^-U delete line
//   ^-K kill to end     ^-C interrupt     ^-D EOF           ^-L clear
//   ^-R reverse search
// Wispr Flow dictation. Flow's default fn and fn+space CANNOT be used: ZMK
// cannot send Apple's fn. Flow also REQUIRES at least one modifier in a
// shortcut, so a bare F-key is rejected as an invalid key. Modifier+F13/F14
// is the safest pairing available: F13-F19 have no default macOS binding at
// all, and the added modifier satisfies Flow's validator.
// Set in Flow Hub > Settings > General > Shortcuts > Change:
//     push-to-talk -> Opt+F13    hands-free -> Opt+F14
//   PTT   = &kp LA(F13) on NAV's left outer thumb. Hold to talk, release to
//           stop and paste. Double-tap it for Flow's own hands-free lock, so
//           this one key covers both modes.
//   HFREE = &kp LA(F14) on NAV, the T position. Tap to start dictating, tap
//           again to stop. Nothing held; use when PTT's hold is unwelcome.
// No &kt latch here: latching a modifier combo would leave Ctrl/Opt stuck
// down and turn every later keystroke into a chord.
// SYS also carries PASTE = Cmd+Ctrl+V, Flow's paste-last-transcript.
//   ^+TAB = Shift-Tab, Claude Code mode cycle
//   ^RET  = Option-Return, newline inside a prompt without submitting
// RIGHT HAND = motion. W<- / W-> are Option-Arrow word jumps, LN<- / LN->
// are Cmd-Arrow line jumps, BACK / FWD are Cmd-[ and Cmd-].
                        bindings = <
   &caps_word &kp LS(TAB) &kp LA(RET) &kp LC(R)      &kp LC(L)      &kp LA(F14)   &kp HOME     &kp PG_DN    &kp PG_UP     &kp END       &kp DEL      &kp LA(BSPC)
   &trans &kp LC(A)   &kp LC(E)   &kp LC(W)      &kp LC(U)      &kp LC(K)     &kp LEFT     &kp DOWN     &kp UP        &kp RIGHT     &kp LG(LBKT) &kp LG(RBKT)
   &trans &kp LC(C)   &kp LC(D)   &kp LG(LS(N4)) &kp LG(LS(N5)) &kp LG(TAB)   &kp LA(LEFT) &kp LG(LEFT) &kp LG(RIGHT) &kp LA(RIGHT) &kp LG(Z)    &kp LG(LS(Z))
                      &kp LA(F13) &trans         &kp LG(SPACE)                &kp RET      &mo SYS      &trans
                        >;
                };

                sym_layer {
                        display-name = "Sym";
// ------------------------------------------------------------------------------------------
// | NUM  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// |      |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  _   |
// |      |  `  |  ~  |  \  | "|" |  -  |   |  =  |  [  |  ]  |  {  |  }  |  :   |
//                    |     | SYS | SPC |   |  .  |     |  +   |
// Digits keep their normal left-to-right order, and the shifted symbol for each
// digit sits directly below it, so there is nothing new to memorise.
// PLUS sits on the right OUTER THUMB. Tap SYM, then slide the same thumb out one
// key: two taps instead of three, and the same motion as PTT on NAV. It takes
// that slot from a &trans fall-through to TAB, which is a fair trade because +=
// and string concatenation are constant in Python and SQL while TAB is still one
// tap away on base.
// Not on this layer, because they are one Shift away from a key you already have:
//   "  = Shift '     ?  = Shift /     <  >  = Shift , .
                        bindings = <
   &tog NUM &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7   &kp N8    &kp N9   &kp N0   &kp BSPC
   &trans &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp UNDER
   &trans &kp GRAVE &kp TILDE &kp BSLH  &kp PIPE  &kp MINUS    &kp EQUAL &kp LBKT &kp RBKT  &kp LBRC &kp RBRC &kp COLON
                    &trans    &mo SYS   &kp SPACE               &kp DOT   &trans   &kp PLUS
                        >;
                };

                num_layer {
                        display-name = "Num";
// ------------------------------------------------------------------------------------------
// | NUM  |     |     |     |     |     |   |  =  |  7  |  8  |  9  |  /  | BKSP |
// |      |     |     |     |     |     |   |  -  |  4  |  5  |  6  |  *  | ENT  |
// |      |     |     |     |     |     |   |  +  |  1  |  2  |  3  |  ,  |  .   |
//                    |     |     |     |   |  0  |     |     |
// Toggled from SYM's top-left key, and off again from the same physical key,
// so it stays on while you key in a long number without holding anything.
// The whole left half falls through to Base, so letters and all four sticky
// modifiers still work while the numpad is active.
                        bindings = <
   &tog NUM &trans &trans &trans &trans &trans  &kp EQUAL &kp N7 &kp N8 &kp N9 &kp FSLH  &kp BSPC
   &trans &trans &trans &trans &trans &trans    &kp MINUS &kp N4 &kp N5 &kp N6 &kp ASTRK &kp RET
   &trans &trans &trans &trans &trans &trans    &kp PLUS  &kp N1 &kp N2 &kp N3 &kp COMMA &kp DOT
                 &trans &trans &trans           &kp N0    &trans &trans
                        >;
                };

                sys_layer {
                        display-name = "Sys";
// ------------------------------------------------------------------------------------------
// |STUDIO| BT1 | BT2 | BT3 | BT4 |BTCLR|   |  F1 |  F2 |  F3 |  F4 |  F5 |  F6  |
// | BOOT | USB | BLE |GLOBE|PASTE|     |   |  F7 |  F8 |  F9 | F10 | F11 | F12  |
// | RESET| W<- | W_v | W^  | W-> |     |   | MUTE| VOL-| VOL+| PREV| NEXT|RESET |
//                    |     |     |     |   |     |     |     |
// Reached with &mo SYS from NAV or SYM.
// W<- W_v W^ W-> are Rectangle window snapping: Cmd+Opt+Ctrl plus an arrow.
// Left to right they follow the same left/down/up/right order as the arrow
// cluster on NAV, mirrored onto the left hand.
// Done as single keys because the alternative is five taps: latching Cmd, then
// Opt, then Ctrl, then NAV, then the arrow, with all five having to land inside
// the 2000ms sticky window. Ctrl and Opt also share the left pinky column, so a
// held three-modifier chord is not physically available on this layout.
// &mo SYS is momentary, so hold it and tap several of these to arrange a few
// windows in one go.
// BT keys are labelled 1-4 to match the OLED. The bindings are BT_SEL 0-3
// because ZMK's keycodes are 0-indexed, while output_status.c prints
// profile_index + 1. So BT_SEL 2 shows as '3' on screen; the label here
// follows the screen so the two agree.
// GLOBE is ZMK's nearest equivalent to the Mac fn/Globe key. It sends HID
// consumer usage 0x029D, which macOS accepts for input-source switching and
// the emoji picker. It is NOT a true Apple fn: it is not treated as a
// modifier, so Globe+arrow and fn+F-key chords do not work. Everything fn
// is normally used for is already bound directly: DEL and HOME/END/PGUP/PGDN
// on NAV, F1-F12 on this layer.
                        bindings = <
   &studio_unlock &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR   &kp F1     &kp F2       &kp F3       &kp F4     &kp F5     &kp F6
   &bootloader    &out OUT_USB &out OUT_BLE &kp GLOBE    &kp LC(LG(V)) &none        &kp F7     &kp F8       &kp F9       &kp F10    &kp F11    &kp F12
   &sys_reset     &kp LG(LA(LC(LEFT))) &kp LG(LA(LC(DOWN))) &kp LG(LA(LC(UP))) &kp LG(LA(LC(RIGHT))) &none   &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_NEXT &sys_reset
                                            &trans       &trans       &trans                   &trans       &trans       &trans
                        >;
                };
        };
};

/* Sticky behaviour tuning.
 * release-after-ms 2000: two seconds to press the next key instead of the
 * default one second, so you are never rushing a chord.
 * ignore-modifiers: lets you stack sticky mods, so Cmd then Shift then key
 * works, and so Shift can be added on top of an active SYM layer.
 */
&sk {
        release-after-ms = <2000>;
        ignore-modifiers;
};

&sl {
        release-after-ms = <2000>;
};

/* caps_word survives _ and - so SNAKE_CASE, CONSTANT_NAMES and SQL keywords
 * all complete in one shot.
 */
&caps_word {
        continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};
